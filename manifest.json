{
  "manifest_version": 3,
  "name": "browser-toolbox",
  "description": "An opinionated collection of small browser tools built for personal use.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://keep.google.com/*"],
      "js": ["src/features/keep-note-viewport.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/features/right-click.js",
        "src/features/responsive-width.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/features/text-viewer.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_title": "Open browser-toolbox"
  },
  "side_panel": {
    "default_path": "src/sidebar/sidebar.html"
  }
}
